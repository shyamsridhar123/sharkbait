{
  "name": "sharkbait",
  "version": "1.0.8",
  "description": "AI-powered coding assistant for the command line. Uses OpenAI Responses API (not Chat). Autonomous agents, parallel code reviews, 36 tools.",
  "type": "module",
  "main": "./dist/cli.js",
  "module": "./dist/cli.js",
  "exports": {
    ".": {
      "import": "./dist/cli.js",
      "default": "./dist/cli.js"
    }
  },
  "bin": {
    "sharkbait": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "scripts": {
    "dev": "bun run src/cli.ts",
    "prebuild": "bun run scripts/sync-version.ts",
    "build": "bun build src/cli.ts --outdir dist --target bun",
    "build:npm": "bun run scripts/sync-version.ts && bun build src/cli.ts --outdir dist --target node --packages=external && sed -i '1s|#!/usr/bin/env bun|#!/usr/bin/env node|' dist/cli.js",
    "build:binary": "bun build src/cli.ts --compile --outfile sharkbait",
    "build:all": "bun run scripts/build-all.ts",
    "test": "bun test",
    "test:e2e": "bun run tests/e2e/real-e2e-tests.ts",
    "test:ux": "bun run tests/e2e/comprehensive-ux-tests.ts",
    "test:llm": "bun run scripts/test-llm-connection.ts",
    "test:agent": "bun run scripts/test-agent-loop.ts",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run typecheck && bun run build:npm",
    "preversion": "bun run typecheck",
    "postversion": "bun run scripts/sync-version.ts && git add src/version.ts && git commit --amend --no-edit && git push && git push --tags",
    "version:patch": "npm version patch",
    "version:minor": "npm version minor",
    "version:major": "npm version major",
    "publish:npm": "npm publish",
    "publish:bun": "bunx npm publish"
  },
  "dependencies": {
    "@azure/identity": "^4.13.0",
    "chalk": "^5.3.0",
    "cli-highlight": "^2.1.11",
    "commander": "^12.1.0",
    "ink": "^4.4.1",
    "ink-link": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "openai": "^4.77.0",
    "react": "^18.2.0",
    "react-devtools-core": "^7.0.1"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^18.2.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "typescript": "^5.0.0",
    "vitest": "^4.0.18"
  },
  "engines": {
    "bun": ">=1.0.0",
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "author": "Shyam Sridhar",
  "license": "MIT",
  "homepage": "https://github.com/shyamsridhar123/sharkbait#readme",
  "bugs": {
    "url": "https://github.com/shyamsridhar123/sharkbait/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/shyamsridhar123/sharkbait.git"
  },
  "keywords": [
    "ai",
    "coding-assistant",
    "cli",
    "llm",
    "azure-openai",
    "bun",
    "typescript",
    "agent",
    "openai"
  ]
}
